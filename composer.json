{
    "name": "scholar/local-foundation",
    "description": "S.C.H.O.L.A.R. local development foundation",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": "8.5.*",
        "ext-pdo": "*",
        "ext-pdo_mysql": "*",
        "ext-mbstring": "*",
        "robmorgan/phinx": "^0.16",
        "vlucas/phpdotenv": "^5.6"
    },
    "autoload": {
        "psr-4": {
            "Scholar\\Auth\\": "app/auth/",
            "Scholar\\": "app/"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": false,
        "platform": {
            "php": "8.5.10"
        }
    }
}
